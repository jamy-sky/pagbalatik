{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pagbalatik",
  "version": "../package.json",
  "identifier": "com.jamysky.pagbalatik",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "jamy-sky",
    "targets": ["nsis"],
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico"
      }
    }
  }
}
